# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# === Anthropic ===
ANTHROPIC_API_KEY=your-anthropic-api-key

# === Tenant ===
# The UUID of the tenant row in Supabase
TENANT_ID=00000000-0000-0000-0000-000000000001

# === WAHA (WhatsApp HTTP API) ===
# Base URL of your WAHA instance (no trailing slash)
WAHA_URL=http://waha.toolip.tech
# Name of the active WAHA session
WAHA_SESSION=snir-session
# Owner's WhatsApp JID to receive alerts and digests (format: 9725XXXXXXXX@c.us)
OWNER_WA_JID=OWNER_WA_JID@c.us

# === Alert settings ===
# Minutes between repeated session-FAILED alerts (dedup cooldown)
ALERT_COOLDOWN_MINUTES=60

# === Classifier settings ===
# Claude model used for message classification
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Minimum confidence score (0-1) to route as high-confidence
CLASSIFIER_CONFIDENCE_THRESHOLD=0.85

# === Pipeline settings ===
PARSER_VERSION=1.0.0
